	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 affine
.PHONY : affine

# fast build rule for target.
affine/fast:
	$(MAKE) $(MAKESILENT) -f cipher/CMakeFiles/affine.dir/build.make cipher/CMakeFiles/affine.dir/build
.PHONY : affine/fast

